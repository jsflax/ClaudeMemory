<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- keychain-access-groups removed: it required a provisioning profile
	     for Developer ID archives, and it was never load-bearing — the
	     daemon is an unsigned CLI that cannot join an access group; token
	     sharing works via per-item keychain ACLs (the Always Allow prompt),
	     which need no entitlement. -->
</dict>
</plist>
